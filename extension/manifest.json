{
  "manifest_version": 3,
  "name": "TabArrange Bridge",
  "version": "0.3.0",
  "description": "Connect your Chrome tabs to the local TabArrange desktop app.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "nativeMessaging",
    "alarms",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect to TabArrange"
  },
  "options_page": "options.html",
  "incognito": "not_allowed",
  "key": "",
  "minimum_chrome_version": "121"
}
